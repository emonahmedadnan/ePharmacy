rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Medicines: Anyone can view medicines (catalog), updates permitted for managers/admins or valid items
    match /medicines/{medicineId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: Anyone can create orders (e.g. guest checkout with phone/bKash), read if owner or authorized
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // User profiles & wallets
    match /users/{userId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
